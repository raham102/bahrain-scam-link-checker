# Copy this file, rename the copy to .env, and paste your own keys after the = sign.
# .env is in .gitignore, so it never goes to GitHub. Do NOT put real keys in this file.

VT_API_KEY=paste-your-virustotal-key-here
GSB_API_KEY=paste-your-google-safe-browsing-key-here
GEMINI_API_KEY=paste-your-gemini-key-here
# Optional: GEMINI_MODEL=gemini-3-flash-preview
   URLSCAN_API_KEY=paste-your-urlscan-key-here
# Optional: URLSCAN_VISIBILITY=unlisted (or private)